ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://shebapath:shebapath@localhost:5432/shebapath
JWT_SECRET=change-this-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000

# LLM (Anthropic). Khali thakle AI sudhu verified tottho theke sorasori uttor dibe.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Embeddings: "openai" (OpenAI-compatible API) ba "hash" (local, development-er jonno)
EMBEDDING_PROVIDER=hash
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Prothom admin (seed script e use hoy)
ADMIN_EMAIL=admin@shebapath.local
ADMIN_PASSWORD=ChangeMe-Admin-123
